{
  "name": "license-board clean: SD10001-SD10007 / TX ACTIVE (seeded individuals, testdata/README.md)",
  "priority": 5,
  "request": {
    "method": "GET",
    "urlPath": "/license-board/licenses",
    "queryParameters": {
      "licenseNo": {
        "matches": "^SD1000[1-7]$"
      },
      "state": {
        "equalTo": "TX"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "source": "LICBOARD",
      "licenseNo": "{{request.query.licenseNo}}",
      "state": "TX",
      "found": true,
      "status": "ACTIVE",
      "expiry": "2030-12"
    }
  },
  "metadata": {
    "source": "license-board",
    "answer": "clean"
  }
}
