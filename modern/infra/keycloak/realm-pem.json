{
  "realm": "pem",
  "displayName": "PEM Provider Enrollment (local)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      { "name": "PROVIDER", "description": "A provider (or their office) using the portal; sees only the NPI in their npi attribute" },
      { "name": "ANALYST", "description": "Enrollment analyst: inquiry, work queues, approve or deny" },
      { "name": "SUPERVISOR", "description": "Supervisor: analyst rights plus sanctions, risk rules and audit" },
      { "name": "ADMIN", "description": "Administrator: batch jobs, legacy files, audit" },
      { "name": "SYSTEM", "description": "Service accounts (client credentials) for service-to-service calls" }
    ]
  },
  "clientScopes": [
    {
      "name": "pem-claims",
      "description": "PEM claims: realm roles and the provider NPI",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username", "claim.name": "preferred_username", "jsonType.label": "String",
            "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true", "introspection.token.claim": "true"
          }
        },
        {
          "name": "given name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName", "claim.name": "given_name", "jsonType.label": "String",
            "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true"
          }
        },
        {
          "name": "family name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "lastName", "claim.name": "family_name", "jsonType.label": "String",
            "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true"
          }
        },
        {
          "name": "npi",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "npi", "claim.name": "npi", "jsonType.label": "String",
            "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true", "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles", "jsonType.label": "String", "multivalued": "true",
            "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true", "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "pem-web",
      "name": "PEM web UI (portal and console)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:5173/*" },
      "defaultClientScopes": ["pem-claims"]
    },
    {
      "clientId": "pem-test",
      "name": "PEM local test client (smoke scripts and Playwright API setup only)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": ["pem-claims"]
    },
    {
      "clientId": "pem-services",
      "name": "PEM service accounts (SYSTEM role)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PEM_SERVICES_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["pem-claims"]
    }
  ],
  "users": [
    {
      "username": "service-account-pem-services",
      "enabled": true,
      "serviceAccountClientId": "pem-services",
      "realmRoles": ["SYSTEM"]
    },
    {
      "username": "provider1", "enabled": true, "firstName": "Pat", "lastName": "Provider", "email": "provider1@pem.local",
      "emailVerified": true,
      "attributes": { "npi": ["1003000111"] },
      "credentials": [{ "type": "password", "value": "${KC_PROVIDER_PASSWORD}", "temporary": false }],
      "realmRoles": ["PROVIDER"]
    },
    {
      "username": "analyst1", "enabled": true, "firstName": "Alex", "lastName": "Analyst", "email": "analyst1@pem.local",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${KC_ANALYST_PASSWORD}", "temporary": false }],
      "realmRoles": ["ANALYST"]
    },
    {
      "username": "supervisor1", "enabled": true, "firstName": "Sam", "lastName": "Supervisor", "email": "supervisor1@pem.local",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${KC_SUPERVISOR_PASSWORD}", "temporary": false }],
      "realmRoles": ["SUPERVISOR"]
    },
    {
      "username": "admin1", "enabled": true, "firstName": "Ada", "lastName": "Admin", "email": "admin1@pem.local",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${KC_ADMIN_PASSWORD}", "temporary": false }],
      "realmRoles": ["ADMIN"]
    }
  ]
}
