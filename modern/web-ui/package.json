{
  "name": "pem-web-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PEM provider portal and analyst console (ADR-008): React + TypeScript + Vite, USWDS, Keycloak OIDC with PKCE.",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "lint": "eslint . --max-warnings 0",
    "api:gen": "node scripts/gen-api.mjs",
    "api:check": "node scripts/gen-api.mjs --check",
    "test": "vitest run --reporter=default --reporter=json --outputFile=test-results/vitest.json && node scripts/no-skipped.mjs test-results/vitest.json",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.0",
    "@trussworks/react-uswds": "13.0.1",
    "@uswds/uswds": "3.14.0",
    "focus-trap-react": "11.0.6",
    "oidc-client-ts": "3.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
