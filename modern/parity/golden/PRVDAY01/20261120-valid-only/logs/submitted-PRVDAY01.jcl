          SAMPLE REHAB 01               1005951276                              
1005923986977815239FA341600000XMAP2021033120260331SAMPLE AMBULANCE 01           
          SAMPLE TRANSPORT 01           1005951276                              
1005925213922490186IN207Q00000X PU2026011099991231DELTA                         
TESTPROV            SD10004        TX                                           
1005932946924589677FA251G00000XHTP2020030120250301SAMPLE HOSPICE 02             
          SAMPLE HOSPICE CARE 02        1005918507                              
1005933068956554998FA251E00000X PU2026011299991231SAMPLE HOME HEALTH 01         
          SAMPLE HOME CARE 01           1005940865                              
1005940865989455927IN207Q00000XLAP2021030120300601ALPHA                         
TESTPROV            SD10001        TX                                           
1005943141988923477FA332B00000XHAP2024080120290801SAMPLE MEDICAL SUPPLY 01      
          SAMPLE DME 01                 1005951276                              
1005947811959195746FA251G00000XHAP2021021520260215SAMPLE HOSPICE 01             
          SAMPLE HOSPICE CARE 01        1005989276                              
1005951276915114135IN225100000XMAP2021011520260115BRAVO                         
TESTPROV            SD10002        TX                                           
1005960046910013327IN225100000X DF2025110199991231ECHO                          
TESTPROV            SD10005        TX                                           
1005988179976525168IN207Q00000XLSP2022050120270501FOXTROT                       
TESTPROV            SD10006        TX                                           
1005989276919110858IN207Q00000XLAP2020120120251201CHARLIE                       
TESTPROV            SD10003        TX                                           
1005992312977520712FA282N00000XLAP2025010120300101SAMPLE HOSPITAL 01            
          SAMPLE MEDICAL CENTER 01      1005940865                              
/*
//LOAD020  EXEC PGM=PRVLDAP1,REGION=4096K
//SYSOUT   DD SYSOUT=A
//APPOUT   DD DSN=&&APPS,DISP=(NEW,PASS,DELETE),UNIT=SYSDA,
//             SPACE=(TRK,(5,5)),
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=6000)
//APPCARD  DD *
1006133288980238025IN207Q00000X   2026011599991231INTAKE ONE                    
TESTPROV            SD20001        TX                                           
1006144350905897911GR193200000X   2026011599991231SAMPLE INTAKE GROUP 01        
          SAMPLE INTAKE CLINIC 01       1005940865                              
1006153716994597855FA282N00000X   2026011599991231SAMPLE INTAKE HOSPITAL 01     
          SAMPLE INTAKE CARE 01         1005989276                              
/*
//LOAD030  EXEC PGM=PRVUNLD1,REGION=4096K
//SYSOUT   DD SYSOUT=A
//PRVMSTR  DD DSN=&&MSTR,DISP=(OLD,PASS)
//FLATOUT  DD DSN=&&BEFORE,DISP=(NEW,PASS,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5)),
//            DCB=(RECFM=FB,LRECL=130,BLKSIZE=1300)
//LOAD040  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=A
//DD01     DD DSN=&&APPS,DISP=(OLD,PASS)
//DD02     DD DSN=&&BEFORE,DISP=(OLD,PASS)
//SYSIN    DD *
 PRINT INFILE(DD01) DUMP
 PRINT INFILE(DD02) DUMP
/*
//STEP010  EXEC PGM=PRVENR01,PARM='BATCH_ID=20261120'
//STEPLIB  DD DSN=MMPRV.PROD.LOADLIB,DISP=SHR
//APPINPUT DD DSN=&&APPS,DISP=(OLD,PASS)
//PRVMSTR  DD DSN=&&MSTR,DISP=(OLD,PASS)
//APPERROR DD DSN=&&APPERR,DISP=(NEW,PASS,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(5,2)),
//            DCB=(RECFM=FB,LRECL=250,BLKSIZE=25000)
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//CAP010   EXEC PGM=PRVUNLD1,REGION=4096K
//SYSOUT   DD SYSOUT=A
//PRVMSTR  DD DSN=&&MSTR,DISP=(OLD,PASS)
//FLATOUT  DD DSN=&&AFT010,DISP=(NEW,PASS,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5)),
//            DCB=(RECFM=FB,LRECL=130,BLKSIZE=1300)
//CAP011   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=A
//DD01     DD DSN=&&APPERR,DISP=(OLD,PASS)
//DD02     DD DSN=&&AFT010,DISP=(OLD,PASS)
//SYSIN    DD *
 PRINT INFILE(DD01) DUMP
 PRINT INFILE(DD02) DUMP
/*
//STEP015  EXEC PGM=PRVUNLD1,COND=(0,LT,STEP010)
//PRVMSTR  DD DSN=&&MSTR,DISP=(OLD,PASS)
//FLATOUT  DD DSN=&&MSTFLAT,DISP=(NEW,PASS,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(5,2)),
//            DCB=(RECFM=FB,LRECL=130,BLKSIZE=1300)
//SYSOUT   DD SYSOUT=*
//STEP020  EXEC PGM=SORT,REGION=1024K,COND=(0,LT,STEP010)
//SORTLIB  DD DSN=SYS1.SORTLIB,DISP=SHR
//SORTIN   DD DSN=&&MSTFLAT,DISP=(OLD,DELETE)
//SORTOUT  DD DSN=&&PRVSORT,DISP=(NEW,PASS,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(20,5)),
//            DCB=(RECFM=FB,LRECL=130,BLKSIZE=1300)
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(5,2))
//SORTWK02 DD UNIT=SYSDA,SPACE=(CYL,(5,2))
//SORTWK03 DD UNIT=SYSDA,SPACE=(CYL,(5,2))
//SYSIN    DD *
  SORT FIELDS=(1,10,CH,A)            COL  1-10  NPI
* LAB: LEGACY CARD  INCLUDE COND=(23,1,CH,EQ,C'U')  IS NOT SUPPORTED BY
* THIS OS/360 SORT (IER005A).  NOTE ALSO THAT COL 23 IS INSIDE THE
* TAXONOMY CODE - PRV-SCREEN-FLAG IS COL 34 (LATENT LEGACY DEFECT).
  RECORD TYPE=F,LENGTH=(130)
  END
/*
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//STEP030  EXEC PGM=PRVSCR01,COND=(0,LT,STEP010)
//PRVMSTR  DD DSN=&&MSTR,DISP=(OLD,PASS)
//SCRNOUT  DD DSN=&&SCRNOUT,DISP=(NEW,PASS,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(10,5)),
//            DCB=(RECFM=FB,LRECL=67,BLKSIZE=6700)
//SYSOUT   DD SYSOUT=*
//CAP030   EXEC PGM=PRVUNLD1,REGION=4096K,COND=(0,LT,STEP010)
//SYSOUT   DD SYSOUT=A
//PRVMSTR  DD DSN=&&MSTR,DISP=(OLD,PASS)
//FLATOUT  DD DSN=&&AFT030,DISP=(NEW,PASS,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5)),
//            DCB=(RECFM=FB,LRECL=130,BLKSIZE=1300)
//STEP040  EXEC PGM=PRVRSK01,COND=(0,LT,STEP010)
//PRVMSTR  DD DSN=&&MSTR,DISP=(OLD,PASS)
//SYSOUT   DD SYSOUT=*
//CAP040   EXEC PGM=PRVUNLD1,REGION=4096K,COND=(0,LT,STEP010)
//SYSOUT   DD SYSOUT=A
//PRVMSTR  DD DSN=&&MSTR,DISP=(OLD,PASS)
//FLATOUT  DD DSN=&&AFT040,DISP=(NEW,PASS,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5)),
//            DCB=(RECFM=FB,LRECL=130,BLKSIZE=1300)
//STEP099  EXEC PGM=IEFBR14,COND=(0,LT)
//SYSOUT   DD SYSOUT=*
//CAP099   EXEC PGM=IDCAMS,COND=(0,LT,STEP010)
//SYSPRINT DD SYSOUT=A
//DD01     DD DSN=&&SCRNOUT,DISP=(OLD,PASS)
//DD02     DD DSN=&&AFT030,DISP=(OLD,PASS)
//DD03     DD DSN=&&AFT040,DISP=(OLD,PASS)
//SYSIN    DD *
 PRINT INFILE(DD01) DUMP
 PRINT INFILE(DD02) DUMP
 PRINT INFILE(DD03) DUMP
