//PRVDAY01 JOB (MMIS,PARITY),'DAILY ENROLLMENT',
//             CLASS=A,MSGCLASS=A,MSGLEVEL=(1,1),
//             REGION=4096K
//*  PARITY RUN valid-only: PRVDAY01 STEPS OF THE LAB DECK, TEMPORARY
//*  DATASETS ONLY (ANONYMOUS JOB), LOAD AND CAP STEPS ADDED
//JOBLIB   DD DSN=MMPRV.PROD.LOADLIB,DISP=SHR
//LOAD010  EXEC PGM=PRVSEED1,REGION=4096K
//SYSOUT   DD SYSOUT=A
//PRVMSTR  DD DSN=&&MSTR(PRIME),DISP=(NEW,PASS,DELETE),UNIT=SYSDA,
//             SPACE=(CYL,(5),,CONTIG),
//             DCB=(DSORG=IS,RECFM=FB,LRECL=130,BLKSIZE=1300,
//             KEYLEN=10,RKP=0,OPTCD=Y,CYLOFL=2)
//SEEDIN   DD *
1005912765913218900GR193200000XLAP2023040120280401SAMPLE CLINIC 01              
          SAMPLE CLINIC GROUP 01        1005940865                              
1005914035967875845FA291U00000X DF2025120199991231SAMPLE LAB 01                 
          SAMPLE LABORATORY 01          1005989276                              
1005918507987804448IN207Q00000XLTP2019020120240201GOLF                          
TESTPROV            SD10007        TX                                           
