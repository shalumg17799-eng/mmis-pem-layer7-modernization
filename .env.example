# Copy to .env (gitignored). Fill a section only when a phase asks for it.
# Never paste these values into the chat.

# --- Phase 1: Neo4j ---
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Phase 4: Jira (only if you use an API token instead of the Atlassian OAuth login) ---
JIRA_SITE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Phase 5: Keycloak test users (local only) ---
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_PROVIDER_PASSWORD=
KC_ANALYST_PASSWORD=
KC_SUPERVISOR_PASSWORD=
KC_ADMIN_PASSWORD=

# --- Phase 5: Postgres (leave empty to use the local docker container) ---
PG_HOST=
PG_PORT=5432
PG_ADMIN_USER=
PG_ADMIN_PASSWORD=
